# ShuiBei source-available local configuration
# Copy to .env and fill locally. Never commit a real .env file.

# Required to run your own Telegram bot process.
SHUIBEI_BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN

# Optional but recommended: pin the expected bot username.
# Leave blank to accept the username returned by Telegram getMe.
SHUIBEI_BOT_USERNAME=

# Required for MoQing Developer API-backed features:
# - antifraud records
# - FakeBot checks
SHUIBEI_DEVELOPER_API_KEY=YOUR_MOQING_API_KEY

# Optional: higher TronGrid quota/reliability for direct TRON/USDT queries.
SHUIBEI_TRONGRID_API_KEY=

# Optional local settings.
SHUIBEI_ADMIN_IDS=
SHUIBEI_DATA_DIR=./runtime-data
SHUIBEI_MAIN_LEDGER_DB=

# Optional: fail closed if ShuiBei cannot enforce owner-only SQLite permissions.
# Public self-hosting defaults to warning-only; official production uses strict mode.
SHUIBEI_STRICT_DB_PERMISSIONS=0

# MiniApp self-hosting.
# The local server can bind to loopback and sit behind Nginx/Caddy/Cloudflare.
SHUIBEI_MINIAPP_HOST=127.0.0.1
SHUIBEI_MINIAPP_PORT=8080
# Telegram WebApp buttons require a public HTTPS URL. Example:
# SHUIBEI_MINIAPP_URL=https://your-domain.example/ShuiBei/app
SHUIBEI_MINIAPP_URL=
